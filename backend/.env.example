# Copiá este archivo como .env y completá los valores de tu MySQL local.
# El archivo .env NO se sube a GitHub (está en .gitignore).
PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ccirr_capacitaciones
DB_USER=root
DB_PASSWORD=tu_clave_de_mysql

# Dirección del frontend: se usa para permitir los pedidos (CORS) y para armar los links de los mails
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
